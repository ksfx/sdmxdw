# Copy to /opt/sdmxdw/sdmxdw.env (chmod 600, owned by the sdmxdw service user)
# and fill in real values. Never commit the filled-in version.

# Database
SDMXDW_DB_URL=jdbc:postgresql://localhost:5432/sdmxdw
SDMXDW_DB_USER=sdmxdw
SDMXDW_DB_PASSWORD=change-me

# Initial password of admin@sdmxdw.local on an empty database (must be changed at first login;
# if unset, a random one is generated and written to the log once)
SDMXDW_ADMIN_PASSWORD=change-me

# Fictional demo data (agency DEMO: loans by region and sector, a small loan register), created
# once on start - for trying out SDMxDW, not for production
SDMXDW_DEMO_DATA=false

# Mail for process failure notifications
SDMXDW_SMTP_HOST=smtp.internal.example.org
SDMXDW_SMTP_PORT=587

# Processes: Python / R runtime, process folder, run data (incl. the secret key - back it up!)
SDMXDW_PYTHON=/opt/sdmxdw/venv/bin/python
SDMXDW_RSCRIPT=Rscript
SDMXDW_R_LIBS=
SDMXDW_PROCESSES_DIR=/opt/sdmxdw/processes
SDMXDW_RUNS_DIR=/opt/sdmxdw/data/runs
SDMXDW_SECRET_KEY_FILE=/opt/sdmxdw/data/secret.key
SDMXDW_GIT_DIR=/opt/sdmxdw/data/git
# only when upgrading an installation with import jobs: their plugin scripts, read once
#SDMXDW_SCRIPTS_DIR=/opt/sdmxdw/plugins

SERVER_PORT=8080
